# ==============================================================================
# 1. OS & IDE TEMPORARY FILES
# ==============================================================================
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.orig
*.rej

# ==============================================================================
# 2. ENVIRONMENT VARIABLES, CREDENTIALS & SECRETS
# ==============================================================================
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials/
*.secret

# Allow configuration examples to be committed safely
!.env.example
!.env.template
!.env.sample
!.env.test.example
!.env.test.template
!.env.development.example
!.env.development.template
!.env.production.example
!.env.production.template
!.env.local.example
!.env.local.template

# ==============================================================================
# 3. GLOBAL DEPENDENCIES, LOGS, & CACHES
# ==============================================================================
node_modules/
target/
.cache/
**/.cache/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo

# ==============================================================================
# 4. APP: DESKTOP (SVELTEKIT + VITE + TAURI V2)
# ==============================================================================
/apps/desktop/.svelte-kit/
/apps/desktop/build/
/apps/desktop/dist/
/apps/desktop/.vite/
/apps/desktop/coverage/
/apps/desktop/playwright-report/
/apps/desktop/test-results/

# Tauri v2 generated schemas
/apps/desktop/src-tauri/gen/schemas/

# ==============================================================================
# 5. MCP SERVERS (NODE.JS / TS)
# ==============================================================================
/mcp-servers/*/node_modules/
/mcp-servers/*/dist/
/mcp-servers/*/build/
/mcp-servers/*/coverage/

# ==============================================================================
# 6. RUNTIME CATE (LOCAL DATABASES & APPLICATION STORAGE)
# ==============================================================================
# Blocks local app-state directories inside the runtime folder
/runtime/storage/
/runtime/data/
/runtime/.data/

# Prevents raw database files from hitting the repo
storage/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# ==============================================================================
# 7. MODELS CRATE & HEAVY MACHINE LEARNING WEIGHTS
# ==============================================================================
# Specific paths inside your models utility crate
/models/cache/
/models/downloads/
/models/weights/
/models/checkpoints/
/models/embeddings/
/models/indexes/
/models/vector-store/
/models/vector_store/
/models/artifacts/
/models/data/

# Heavy model extensions used by BERT/Nomic
*.gguf
*.ggml
*.safetensors
*.onnx
*.pt
*.pth
*.bin
*.model
*.tflite
*.mlmodel
*.ckpt
*.h5
*.pb

# ==============================================================================
# 8. VECTOR DATABASE ENGINE FILES
# ==============================================================================
chroma/
qdrant_storage/
lancedb/
weaviate_data/
milvus_data/

# ==============================================================================
# 9. TESTING, PERFORMANCE PROFILING & PYTHON EXTENSIONS
# ==============================================================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.old
coverage/
lcov.info
criterion/
*.profraw
*.profdata

# Python sandbox tooling environment targets
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
